<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ABA Automation & Integration Flow Matrix</title>
    <style>
        :root {
            --bg-deep: #090d16;
            --bg-card: #131c2e;
            --border-line: #243557;
            --text-pure: #ffffff;
            --text-dim: #8ba2cb;
            --monday-color: #00cff4;
            --make-color: #ff5c93;
            --success-green: #00e676;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { background-color: var(--bg-deep); color: var(--text-pure); padding: 20px; line-height: 1.4; }
        .wrapper { max-width: 850px; margin: 0 auto; }

        /* Header Infrastructure */
        header { margin-bottom: 25px; border-bottom: 1px solid var(--border-line); padding-bottom: 15px; }
        header h1 { font-size: 1.6rem; font-weight: 800; color: var(--text-pure); }
        header p { color: var(--text-dim); font-size: 0.9rem; margin-top: 4px; }
        .badge-row { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
        .badge { font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 4px; text-transform: uppercase; }
        .b-monday { background: rgba(0, 207, 244, 0.15); color: var(--monday-color); border: 1px solid var(--monday-color); }
        .b-make { background: rgba(255, 92, 147, 0.15); color: var(--make-color); border: 1px solid var(--make-color); }

        /* Pipeline Steps Grid */
        .pipeline-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 25px; }
        .step-card { background: var(--bg-card); border: 1px solid var(--border-line); border-radius: 8px; padding: 15px; position: relative; transition: all 0.3s ease; }
        .step-card.active { border-color: var(--monday-color); box-shadow: 0 0 12px rgba(0, 207, 244, 0.2); }
        .step-num { font-size: 0.75rem; font-weight: 800; color: var(--text-dim); text-transform: uppercase; margin-bottom: 5px; }
        .step-title { font-weight: 700; font-size: 1.05rem; margin-bottom: 4px; }
        .step-desc { font-size: 0.8rem; color: var(--text-dim); }

        /* Interactive Simulator Control Panel */
        .control-panel { background: var(--bg-card); border: 1px solid var(--border-line); border-radius: 8px; padding: 20px; margin-bottom: 25px; }
        .panel-title { font-weight: 700; font-size: 1.1rem; margin-bottom: 15px; display: flex; align-items: center; gap: 8px; }
        .pulse-dot { width: 8px; height: 8px; background: var(--success-green); border-radius: 50%; display: inline-block; animation: pulse 1.5s infinite; }
        
        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-dim); margin-bottom: 6px; }
        select, input { width: 100%; padding: 10px; background: var(--bg-deep); border: 1px solid var(--border-line); border-radius: 6px; color: white; font-size: 0.95rem; outline: none; }
        select:focus, input:focus { border-color: var(--monday-color); }

        .trigger-btn { width: 100%; padding: 12px; background: var(--monday-color); color: #000; border: none; border-radius: 6px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: background 0.2s; }
        .trigger-btn:hover { background: #5ce5fc; }

        /* Real-time Automation Logs Execution Window */
        .log-window { background: #05070b; border: 1px solid var(--border-line); border-radius: 6px; padding: 15px; font-family: 'Courier New', Courier, monospace; height: 180px; overflow-y: auto; }
        .log-entry { font-size: 0.85rem; margin-bottom: 6px; line-height: 1.3; }
        .log-time { color: var(--text-dim); margin-right: 6px; }
        .log-success { color: var(--success-green); }
        .log-alert { color: var(--monday-color); }
        .log-make { color: var(--make-color); }

        @keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 230, 118, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(0, 230, 118, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 230, 118, 0); }
        }

        @media (max-width: 600px) {
            .pipeline-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <div class="wrapper">
        <header>
            <h1>ABA Client Journey Automation Flow</h1>
            <p>Interactive asynchronous pipeline tracking multi-regional intake & insurance authorizations</p>
            <div class="badge-row">
                <span class="badge b-monday">Monday.com API Node</span>
                <span class="badge b-make">Make / Integromat Webhook</span>
                <span class="badge" style="background: rgba(234,179,8,0.15); color: #eab308; border: 1px solid #eab308;">Python Data Logic</span>
            </div>
        </header>

        <!-- VISUAL PIPELINE TRACKING CARDS -->
        <div class="pipeline-grid">
            <div class="step-card active" id="card-intake">
                <div class="step-num">Stage 01</div>
                <div class="step-title">Client Intake</div>
                <div class="step-desc" id="desc-intake">Awaiting user form submission payload...</div>
            </div>
            <div class="step-card" id="card-auth">
                <div class="step-num">Stage 02</div>
                <div class="step-title">Authorizations</div>
                <div class="step-desc" id="desc-auth">Pending clinical documentation routing.</div>
            </div>
            <div class="step-card" id="card-staffing">
                <div class="step-num">Stage 03</div>
                <div class="step-title">BCBA Staffing</div>
                <div class="step-desc" id="desc-staffing">Awaiting regional provider allocation.</div>
            </div>
        </div>

        <!-- SIMULATOR CONTROL PANEL -->
        <div class="control-panel">
            <div class="panel-title"><span class="pulse-dot"></span> Execute Live Webhook Web-Form Trigger</div>
            
            <div class="form-group">
                <label>Target Expansion Region</label>
                <select id="input-region">
                    <option value="New York (Five Boroughs)">New York (Five Boroughs)</option>
                    <option value="North Carolina Regional">North Carolina Regional</option>
                    <option value="Arizona Pilot Expansion">Arizona Pilot Expansion</option>
                    <option value="Utah Hub">Utah Hub</option>
                </select>
            </div>

            <div class="form-group">
                <label>Assigned Intake Priority</label>
                <select id="input-priority">
                    <option value="Standard Care Placement">Standard Care Placement</option>
                    <option value="Expedited Clinical Review">Expedited Clinical Review (High Priority)</option>
                </select>
            </div>

            <button class="trigger-btn" onclick="runSimulation()">Inject Form Data & Fire Integration Webhook</button>
        </div>

        <!-- SYSTEM OPERATIONAL LOGS CONTAINER -->
        <div class="log-window" id="log-display">
            <div class="log-entry"><span class="log-time">[09:00:00]</span> <span class="log-success">System Online.</span> Integration listeners active on port 443. Ready for webhook payload.</div>
        </div>
    </div>

    <!-- PIPELINE EXECUTION ALGOTHM ENGINE -->
    <script>
        const logDisplay = document.getElementById('log-display');

        function addLog(message, type = '') {
            const timeStr = new Date().toLocaleTimeString();
            const logEntry = document.createElement('div');
            logEntry.className = 'log-entry';
            
            let typeClass = '';
            if (type === 'success') typeClass = 'log-success';
            if (type === 'alert') typeClass = 'log-alert';
            if (type === 'make') typeClass = 'log-make';

            logEntry.innerHTML = `<span class="log-time">[${timeStr}]</span> <span class="${typeClass}">${message}</span>`;
            logDisplay.appendChild(logEntry);
            logDisplay.scrollTop = logDisplay.scrollHeight;
        }

        function runSimulation() {
            const region = document.getElementById('input-region').value;
            const priority = document.getElementById('input-priority').value;

            // Reset UI Visual Elements
            document.querySelectorAll('.step-card').forEach(c => c.classList.remove('active'));
            
            // Phase 1: Intake Form Webhook Trigger
            document.getElementById('card-intake').classList.add('active');
            document.getElementById('desc-intake').innerText = `Active: Processing client for ${region}.`;
            addLog(`Outgoing JSON payload sent to Make.com webhook endpoint...`, 'make');
            
            setTimeout(() => {
                addLog(`Make.com routed request: Processing ${priority} parameters successfully.`, 'make');
                addLog(`API POST Request executed to Monday.com workspace boards.`, 'alert');
                
                // Phase 2: Move to Insurance/Authorizations Node
                document.querySelectorAll('.step-card').forEach(c => c.classList.remove('active'));
                document.getElementById('card-auth').classList.add('active');
                document.getElementById('desc-auth').innerText = `Authorization matching verified for ${region}.`;
                addLog(`Monday.com Automation: Board column changed -> Triggered document match validation loop.`, 'alert');
                addLog(`Authorization confirmation payload securely cached.`, 'success');

                setTimeout(() => {
                    // Phase 3: Move to Local Regional Staffing
                    document.querySelectorAll('.step-card').forEach(c => c.classList.remove('active'));
                    document.getElementById('card-staffing').classList.add('active');
                    document.getElementById('desc-staffing').innerText = `BCBA regional matching initiated.`;
                    addLog(`Asynchronous routing complete: Client allocated to ${region} operations pool.`, 'success');
                    addLog(`Pipeline finalized. Notification notification broadcasted via system webhooks.`, 'success');
                }, 1800);

            }, 1200);
        }
    </script>
</body>
</html>
